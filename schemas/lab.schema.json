{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyberrange.local/schemas/rhsa-lab-v1.json",
  "title": "CyberRange Linux Sysadmin Lab Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "id",
    "title",
    "version",
    "module",
    "difficulty",
    "submission",
    "environment",
    "execution",
    "grading"
  ],
  "properties": {
    "contract_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^(?:RHSA-[A-Z0-9]+|TUPE-C[0-9]{2})-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "version": {
      "type": [
        "string",
        "integer"
      ]
    },
    "module": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "difficulty": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "submission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "interpreter"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+\\.sh$"
        },
        "interpreter": {
          "const": "bash"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "timeout_seconds",
        "memory",
        "cpus",
        "pids_limit",
        "network"
      ],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "build_context": {
          "type": "string",
          "minLength": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "memory": {
          "type": "string",
          "pattern": "^[0-9]+[mMgG]$"
        },
        "cpus": {
          "type": [
            "string",
            "number"
          ]
        },
        "pids_limit": {
          "type": [
            "string",
            "integer"
          ]
        },
        "network": {
          "const": "none"
        }
      }
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "random_username",
              "random_group",
              "random_token",
              "random_ipv4",
              "random_int",
              "literal"
            ]
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "min": {
            "type": "integer"
          },
          "max": {
            "type": "integer"
          }
        }
      },
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "repeat_for_idempotency"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "repeat_for_idempotency": {
          "const": true
        }
      }
    },
    "grading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_points",
        "pass_score",
        "criteria"
      ],
      "properties": {
        "total_points": {
          "type": "integer",
          "minimum": 1
        },
        "pass_score": {
          "type": "integer",
          "minimum": 0
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "points"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "points": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "learning_objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    }
  }
}
